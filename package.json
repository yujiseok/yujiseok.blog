{
  "name": "yujiseok",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check": "turbo run typecheck test //#lint",
    "translate": "turbo run translate",
    "resume:plugin": "turbo run build --filter=@repo/figma-resume-sync",
    "resume:pdf": "turbo run resume:pdf"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  }
}
