{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "code.js"],
      "env": ["GA_ID", "SPOTIFY_*"],
      "passThroughEnv": ["VERCEL", "CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "translate": {
      "cache": false,
      "passThroughEnv": ["CI", "VERCEL"]
    },
    "resume:pdf": {
      "cache": false,
      "passThroughEnv": ["FIGMA_TOKEN"]
    }
  }
}
